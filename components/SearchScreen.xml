<?xml version="1.0" encoding="utf-8"?>
<component name="SearchScreen" extends="Screen">
    <!-- YouTube-style TV layout: top search bar, left history & suggestions,
         compact keyboard on the right, and recommended / live results below. -->
    <interface>
        <!-- The one action Search reports upward: a push request. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />
    <script type="text/brightscript" uri="pkg:/source/stores/SearchHistoryStore.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/UiLayout.brs" />

    <children>
        <Rectangle id="searchBg" width="1920" height="1080" color="0x0E1110FF" />

        <!-- Wide Top Search Bar (YouTube TV style) -->
        <Group id="searchBarGroup" translation="[136, 32]">
            <Rectangle id="searchBarBg" width="1648" height="52" color="0x181D1AFF" />
            <Poster id="searchBarIcon" translation="[18, 14]" width="24" height="24" uri="pkg:/images/search.png" />
            <Label id="searchQueryDisplay" translation="[58, 10]" width="1560" height="32" text="Pesquisar" font="font:MediumSystemFont" />
        </Group>

        <Label
            id="searchTitle"
            translation="[136, 32]"
            width="10"
            height="10"
            text="Search"
            visible="false" />
        <Label
            id="searchSub"
            translation="[136, 32]"
            width="10"
            height="10"
            text=""
            visible="false" />

        <!-- Left column: History and suggestions -->
        <Group id="historyGroup" translation="[136, 104]" visible="false">
            <Label
                id="historyTitle"
                width="560"
                height="40"
                font="font:MediumBoldSystemFont" />
            <LabelList
                id="historyList"
                translation="[0, 48]"
                itemSize="[560, 48]"
                numRows="6"
                vertFocusAnimationStyle="fixedFocus" />
            <Button
                id="clearHistoryBtn"
                translation="[0, 350]"
                minWidth="240"
                maxWidth="270" />
            <Button
                id="removeHistoryBtn"
                translation="[285, 350]"
                minWidth="240"
                maxWidth="270" />
        </Group>

        <!-- Right column: Compact keyboard in guarded viewport -->
        <Group id="keyboardViewport" translation="[740, 104]" clippingRect="[0, 0, 760, 580]">
            <DynamicKeyboard id="liveKeyboard" scale="[0.5, 0.5]" domain="generic" />
        </Group>
        <Timer id="keyboardLayoutTimer" duration="0.1" repeat="false" />
        <Label
            id="searchStatus"
            translation="[740, 484]"
            width="760"
            height="56"
            wrap="true"
            numLines="2"
            lineSpacing="4"
            font="font:SmallSystemFont" />
        <Button id="showResults" translation="[740, 546]" minWidth="360" maxWidth="480" visible="false" />
        <Button id="retrySearchBtn" translation="[1120, 546]" minWidth="240" maxWidth="360" visible="false" />
        <Timer id="searchDebounce" duration="0.6" repeat="false" />

        <!-- Bottom row: Results / Recommendations section -->
        <Label
            id="resultsHeader"
            translation="[136, 616]"
            width="1648"
            height="32"
            font="font:MediumBoldSystemFont"
            visible="false" />

        <!-- Results grid: poster rows, one per catalog that returned results. -->
        <RowList
            id="searchResults"
            clippingRect="[-8, -8, 1664, 430]"
            translation="[136, 654]"
            numRows="1"
            itemSize="[1648, 360]"
            itemSpacing="[0, 40]"
            rowItemSize="[[240, 360]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="[true]"
            rowLabelOffset="[0, 10]"
            rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="true"
            itemComponentName="PosterTile" />
    </children>
</component>
