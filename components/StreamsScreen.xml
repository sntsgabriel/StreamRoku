<?xml version="1.0" encoding="utf-8"?>
<component name="StreamsScreen" extends="Screen">
    <!-- Stream picker for a movie or episode, pushed with
         { addonAddress, metaType, metaId, videoId, season, episode, position,
           name, poster, logo, background } plus the panel's data the pusher
           holds (description + runtime for a movie; episodeName +
           episodeOverview for a series from EpisodesScreen). Two panes:
           - left: title (series + episode line), synopsis, and the Cinemeta
             background artwork (no poster), all from the params;
           - right: one selectable stream card per candidate, collected from
             every installed add-on that advertises the "stream" resource in
             parallel — one StreamsLoaderTask per provider, so cards appear as
             each provider resolves instead of after all of them finish.
         OK on a card resolves playback and pushes the PlayerScreen; resolution
         failures (e.g. torrent streams without a streaming server) surface in
         the status line. -->
    <interface>
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/StreamsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />
    <script type="text/brightscript" uri="pkg:/source/util/StreamFilter.brs" />

    <children>
        <Rectangle id="streamBg" width="1920" height="1080" />
        <Poster id="bgPoster" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
        <Poster id="bgGradient" width="1920" height="1080" uri="pkg:/images/hero-gradient.png" loadDisplayMode="scaleToFill" />
        <Rectangle id="bgScrim" width="1920" height="1080" />

        <!-- Left: title + optional episode line + synopsis. No poster. -->
        <Label
            id="headTitle"
            translation="[80, 100]"
            width="620"
            height="86"
            horizAlign="left"
            wrap="true"
            font="font:LargeBoldSystemFont" />
        <Label
            id="headSub"
            translation="[80, 192]"
            width="620"
            height="40"
            font="font:MediumSystemFont" />
        <Label
            id="synopsis"
            translation="[80, 240]"
            width="620"
            height="620"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:SmallSystemFont" />
        <Label
            id="status"
            translation="[80, 920]"
            width="620"
            height="100"
            wrap="true"
            horizAlign="left"
            vertAlign="top"
            font="font:SmallSystemFont" />

        <!-- Right: provider header (arrows + name + segment dots) above the
             selectable stream list. The arrows appear only for directions the
             user can actually move; the segments mark the position among the
             providers. -->
        <Poster
            id="arrowLeft"
            translation="[760, 98]"
            width="36"
            height="36"
            uri="pkg:/images/arrow-left.png"
            visible="false" />
        <Label
            id="providerName"
            translation="[806, 96]"
            width="580"
            height="40"
            horizAlign="left"
            wrap="true"
            font="font:MediumBoldSystemFont" />
        <Poster
            id="arrowRight"
            translation="[1396, 98]"
            width="36"
            height="36"
            uri="pkg:/images/arrow-right.png"
            visible="false" />
        <Label
            id="filterStatus"
            translation="[1440, 102]"
            width="400"
            height="30"
            horizAlign="right"
            font="font:SmallSystemFont" />
        <Group
            id="providerSegments"
            translation="[760, 146]" />
        <RowList
            id="streamsList"
            translation="[760, 172]"
            numRows="1"
            itemSize="[1080, 312]"
            itemSpacing="[0, 12]"
            rowItemSize="[[1080, 300]]"
            rowItemSpacing="[[0, 0]]"
            showRowLabel="false"
            drawFocusFeedback="false"
            itemComponentName="StreamTile" />

        <Group id="placeholderGroup" translation="[760, 172]" visible="false">
            <Rectangle id="placeholderCard" width="1080" height="240" />
            <Label
                id="streamsPlaceholder"
                translation="[40, 32]"
                width="1000"
                height="70"
                wrap="true"
                horizAlign="left"
                vertAlign="top"
                font="font:MediumBoldSystemFont" />
            <Label
                id="streamsPlaceholderHint"
                translation="[40, 108]"
                width="1000"
                height="60"
                wrap="true"
                horizAlign="left"
                vertAlign="top"
                font="font:SmallSystemFont" />
            <Button
                id="clearFilterBtn"
                translation="[40, 172]"
                minWidth="280"
                maxWidth="360"
                visible="false" />
        </Group>
    </children>
</component>
