<?xml version="1.0" encoding="utf-8"?>
<component name="RailTile" extends="Group">
    <!-- Square icon tile for the Home left rail. RowList drives it through the
         same read-only interface fields as every tile (itemContent /
         itemHasFocus / rowHasFocus). The icon glyph comes from
         itemContent.title; navigation to the target screen happens in
         HomeScreen's rowItemSelected observer. -->
    <interface>
        <field id="itemContent" type="node" />
        <field id="itemHasFocus" type="boolean" />
        <field id="rowHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/RailTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />

    <children>
        <!-- railBorder is the frame, railFace the inset face so focus draws a
             border instead of painting over the tile. -->
        <Animation id="zoomAnim" duration="0.18">
            <Vector2DFieldInterpolator
                id="zoomInterp"
                fieldToInterp="railGlyph.scale"
                key="[0.0, 1.0]"
                keyValue="[[1.0, 1.0], [1.15, 1.15]]" />
        </Animation>

        <Animation id="labelAnimation" duration="0.18" repeat="false">
            <FloatFieldInterpolator id="labelOpacityInterpolator" fieldToInterp="railLabel.opacity" key="[0, 1]" keyValue="[0, 1]" />
        </Animation>
        <Rectangle id="railBorder" width="332" height="88">
            <!-- Active indicator: distinct vertical accent bar for the active navigation section -->
            <Rectangle id="activeIndicator" width="4" height="36" translation="[4, 26]" visible="false" />
            <Poster
                id="railGlyph"
                width="42"
                height="42"
                loadWidth="42"
                loadHeight="42"
                loadDisplayMode="limitSize"
                scaleRotateCenter="[21, 21]"
                translation="[16, 23]" />
            <Label id="railLabel" opacity="0" translation="[72, 0]" width="250" height="88" vertAlign="center" font="font:SmallBoldSystemFont" />
        </Rectangle>
    </children>
</component>
