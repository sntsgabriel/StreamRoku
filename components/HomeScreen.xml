<?xml version="1.0" encoding="utf-8"?>
<component name="HomeScreen" extends="Screen">
    <interface>
        <!-- The one action Home reports upward: a push request. The Scene
             observes it and calls ScreenStack.push with a target + params. -->
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back.
             callFunc only runs for functions declared in the interface. Stores
             are class instances and cannot cross components through a field,
             so they arrive via callFunc. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="RebuildRows" />
        <function name="EnsureCurrentRows" />
        <function name="RefreshContinueWatching" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />

    <children>
        <Rectangle id="homeBg" width="1920" height="1080" color="0x0" />
        <Label
            id="homeTitle"
            translation="[340, 36]"
            width="1520"
            height="60"
            text=""
            font="font:LargeBoldSystemFont" />
        <Label
            id="homeSub"
            translation="[340, 98]"
            width="1520"
            height="34"
            text=""
            font="font:SmallSystemFont" />

        <!-- Left rail: the vertical icon menu (Search, Discover, Library,
             Add-ons, Settings, Support). A one-column RowList of RailTiles; OK
             on an icon publishes a pushRequest the Scene routes. Focus reaches
             it from the grid via Left/Right. -->
        <Label id="selectedTitle" translation="[340, 140]" width="1520" height="40" font="font:MediumBoldSystemFont" />
        <Label id="emptyState" translation="[420, 380]" width="1300" height="180" wrap="true" font="font:MediumSystemFont" visible="false" />
        <Rectangle id="railBg" width="310" height="1080"/>
        <Label id="brand" translation="[30, 46]" width="270" height="60" text="Rokumio" font="font:LargeBoldSystemFont" />
        <RowList
            id="rail"
            translation="[16, 210]"
            numRows="6"
            itemSize="[278, 88]"
            itemSpacing="[0, 22]"
            rowItemSize="[[278, 88]]"
            focusXOffset="[0]"
            rowItemSpacing="[[0, 0]]"
            showRowLabel="[false]"
            drawFocusFeedback="false"
            itemComponentName="RailTile"
            vertFocusAnimationStyle="floatingFocus"/>

        <!-- Poster rows: a single RowList owns the whole grid physics (vertical
             row scrolling/clipping, horizontal per-row tiles, row labels). Each
             item renders as a PosterTile component. Content is set in code. -->
        <RowList
            id="catalog"
            translation="[340, 210]"
            numRows="2"
            itemSize="[1540, 405]"
            itemSpacing="[0, 66]"
            rowItemSize="[[270, 405]]"
            rowItemSpacing="[[18, 0]]"
            showRowLabel="[true]"
            rowLabelFont="font:MediumBoldSystemFont"
            drawFocusFeedback="true"
            itemComponentName="PosterTile" />
    </children>
</component>
