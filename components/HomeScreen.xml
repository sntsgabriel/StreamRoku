<?xml version="1.0" encoding="utf-8"?>
<component name="HomeScreen" extends="Screen">
    <interface>
        <!-- The one action Home reports upward: a push request. -->
        <field id="libraryChange" type="assocarray" alwaysNotify="true" />
        <field id="homeEdit" type="assocarray" alwaysNotify="true" />
        <field id="pushRequest" type="assocarray" alwaysNotify="true" />

        <!-- Screen contract: called by ScreenStack for show/hide/focus/back. -->
        <function name="OnEnter" />
        <function name="OnExit" />
        <function name="OnBackPressed" />
        <function name="RebuildRows" />
        <function name="EnsureCurrentRows" />
        <function name="RefreshContinueWatching" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/core/AsyncTask.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/Theme.bs" />
    <script type="text/brightscript" uri="pkg:/source/core/TileSize.bs" />
    <script type="text/brightscript" uri="pkg:/source/util/Helpers.brs" />

    <script type="text/brightscript" uri="pkg:/source/util/HomeLayout.brs" />

    <children>
        <Rectangle id="homeBg" width="1920" height="1080" color="0x0B0D12FF" />

        <!-- Immersive Hero Background Artwork (full screen 1920x1080 with crossfade and dark gradient) -->
        <Group id="heroArtworkGroup">
            <Poster
                id="heroBg"
                width="1920"
                height="1080"
                loadDisplayMode="scaleToZoom"
                opacity="1.0" />
            <Poster
                id="heroBgNext"
                width="1920"
                height="1080"
                loadDisplayMode="scaleToZoom"
                opacity="0.0" />
            <Poster
                id="heroGradient"
                width="1920"
                height="1080"
                uri="pkg:/images/hero-gradient.png"
                loadDisplayMode="scaleToFill" />
        </Group>

        <Animation id="heroCrossfadeAnim" duration="0.3" repeat="false">
            <FloatFieldInterpolator id="heroCrossfadeInterp" fieldToInterp="heroBgNext.opacity" key="[0, 1]" keyValue="[0.0, 1.0]" />
        </Animation>
        <Timer id="heroDebounceTimer" duration="0.25" repeat="false" />

        <!-- Catalog and Hero Info Area: repositions smoothly when the navigation menu expands -->
        <Group id="catalogArea" translation="[136, 0]">
            <!-- Reserve space for tall and wide logos, then metadata, synopsis and resume. -->
            <Group id="heroInfoGroup" translation="[0, 80]">
                <Poster
                    id="heroLogo"
                    width="540"
                    height="160"
                    loadDisplayMode="scaleToFit"
                    visible="false" />
                <Label
                    id="heroTitle"
                    translation="[0, 48]"
                    width="1000"
                    height="64"
                    font="font:LargeBoldSystemFont" />
                <Label
                    id="heroMeta"
                    translation="[0, 180]"
                    width="1000"
                    height="32"
                    font="font:SmallBoldSystemFont" />
                <Label
                    id="heroDesc"
                    translation="[0, 222]"
                    width="920"
                    height="64"
                    maxLines="2"
                    wrap="true"
                    font="font:SmallSystemFont" />
                <Label id="heroProgress" translation="[0, 298]" width="1100" height="36" visible="false" font="font:SmallBoldSystemFont" />
                <Group id="heroActionsGroup" translation="[0, 348]" visible="false">
                    <Button
                        id="heroWatchBtn"
                        minWidth="200"
                        maxWidth="280"
                        height="48"
                        text="Assistir"
                        textFont="font:SmallBoldSystemFont"
                        focusedTextFont="font:SmallBoldSystemFont" />
                    <Button
                        id="heroDetailsBtn"
                        translation="[220, 0]"
                        minWidth="200"
                        maxWidth="280"
                        height="48"
                        text="Detalhes"
                        textFont="font:SmallBoldSystemFont"
                        focusedTextFont="font:SmallBoldSystemFont" />
                </Group>
            </Group>

            <!-- Compatibility labels for headers and empty states -->
            <Label
                id="homeTitle"
                translation="[0, 32]"
                width="1600"
                height="32"
                text=""
                visible="false"
                font="font:SmallBoldSystemFont" />
            <Label
                id="selectedTitle"
                translation="[0, 68]"
                width="1600"
                height="56"
                visible="false"
                font="font:LargeBoldSystemFont" />
            <Label
                id="homeSub"
                translation="[0, 32]"
                width="1600"
                height="32"
                text=""
                font="font:SmallSystemFont" />

            <Label
                id="emptyState"
                translation="[40, 320]"
                width="1200"
                height="180"
                wrap="true"
                font="font:MediumSystemFont"
                visible="false" />

            <!-- Poster rows: single RowList owning grid physics -->
            <RowList
                id="catalog"
                translation="[0, 474]"
                numRows="2"
                itemSize="[1784, 405]"
                itemSpacing="[0, 66]"
                rowItemSize="[[270, 405]]"
                rowItemSpacing="[[18, 0]]"
                showRowLabel="[true]"
                rowLabelFont="font:MediumBoldSystemFont"
                vertFocusAnimationStyle="fixedFocus"
                drawFocusFeedback="true"
                drawFocusFeedbackOnMakeFocused="true"
                itemComponentName="PosterTile" />
        </Group>

        <!-- Left rail: the vertical icon menu (Netflix style). Overlays the left edge
             and expands smoothly without cutting catalog text. -->
        <Group id="railClip" clippingRect="[0, 0, 96, 1080]">
            <Rectangle id="railBg" width="96" height="1080" />

            <!-- User Profile Header (Netflix style) -->
            <Group id="profileGroup" translation="[24, 32]">
                <Rectangle id="avatarBg" width="48" height="48" color="0x8B5CF6FF" />
                <Label id="avatarInitial" translation="[14, 8]" width="24" height="32" text="U" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
                <Label id="profileName" translation="[64, 0]" width="224" height="36" text="" opacity="0"><Font role="font" uri="pkg:/fonts/OpenSans-Bold.ttf" size="24" /></Label>
                <Label id="profileSub" translation="[64, 38]" width="224" height="28" text="" opacity="0"><Font role="font" uri="pkg:/fonts/OpenSans-Regular.ttf" size="20" /></Label>
            </Group>

            <Label id="brand" translation="[24, 112]" width="300" height="50" text="Rokumio" opacity="0" font="font:LargeBoldSystemFont" />
            <Label id="compactBrand" translation="[24, 112]" width="60" height="50" text="R" font="font:LargeBoldSystemFont" />

            <RowList
                id="rail"
                translation="[16, 184]"
                numRows="9"
                itemSize="[332, 88]"
                itemSpacing="[0, 12]"
                rowItemSize="[[332, 88]]"
                focusXOffset="[0]"
                rowItemSpacing="[[0, 0]]"
                showRowLabel="[false]"
                drawFocusFeedback="false"
                itemComponentName="RailTile"
                vertFocusAnimationStyle="floatingFocus" />
        </Group>
        <HomeMenu id="homeMenu" visible="false" />
        <Animation id="railAnimation" duration="0.22" repeat="false">
            <FloatFieldInterpolator id="railWidthInterpolator" fieldToInterp="railBg.width" key="[0, 1]" keyValue="[96, 360]" />
        </Animation>
    </children>
</component>
