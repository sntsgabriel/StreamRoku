' Theme.bs — the app's single source of truth for colors.
'
' Every component that paints custom colors reads them from Theme() instead of
' hardcoding hex literals, so the whole look is driven from this one file. The
' palette is cached on the caller's m (each component keeps its own copy).
' Secondary text and the navigation rail use higher contrast for TV viewing.
'
' XML cannot call code, so XML color attributes are migrated into each
' component's init() and assigned from here. The transparent "0x0" backdrops
' are the absence of color, not a theme, and stay literal in the XML.
'
' The native dialogs keep Roku's RSGPalette shape; AppPalette() builds that
' node from the same palette so the dialogs share the app's look.
'
' danger is the one color that is not part of the app's look: it marks a broken
' invariant (see MainScene's ReportStoreFault) rather than styling content, and
' it lives here anyway so nothing in the codebase has to hardcode a hex literal.
function Theme() as object
    if m._theme = invalid
        m._theme = {
            accent: "0x8B5CF6FF"
            accentFocus: "0x8B5CF6FF"
            accentClear: "0x8B5CF600"
            accentDim: "0x8B5CF64D"
            accentFaint: "0x8B5CF626"
            accentSecondary: "0xA78BFAFF"
            accentWarm: "0xF59E0BFF"
            accentInfo: "0x38BDF8FF"
            textPrimary: "0xFFFFFFFF"
            textSecondary: "0xA1A1AAFF"
            textWhite: "0xFFFFFFFF"
            danger: "0xEF4444FF"
            screenBg: "0x0B0D12FF"
            secondaryBg: "0x151923FF"
            tileFace: "0x1C2130FF"
            tileFaceFocus: "0x242B3EFF"
            cardSurface: "0x1C2130FF"
            cardSurfaceFocus: "0x242B3EFF"
            itemFace: "0x151923FF"
            mediaPanelBg: "0x151923FF"
            mediaPanelInk: "0x0B0D12FF"
            mediaPanelMuted: "0xA1A1AAFF"
            mediaPanelAccent: "0x8B5CF6FF"
            dropdownBg: "0x151923FF"
            playerBg: "0x000000FF"
            railTint: "0x0B0D12FA"
            scrim: "0x0B0D12D9"
            progressTrack: "0x1C2130AA"
            progressFill: "0x8B5CF6FF"
            glyphPlate: "0x0B0D12CC"
            segmentIdle: "0x23293BFF"
        }
    end if
    return m._theme
end function

' The RSGPalette for the native StandardDialogs, assembled from the app palette
' so the dialogs restyle with the rest of the app.
function AppPalette() as object
    c = Theme()
    palette = CreateObject("roSGNode", "RSGPalette")
    palette.colors = {
        DialogBackgroundColor: c.dropdownBg
        DialogItemColor: c.accent
        DialogTextColor: c.textPrimary
        DialogFocusColor: c.accent
        DialogFocusItemColor: c.screenBg
        DialogSecondaryTextColor: c.textSecondary
        DialogSecondaryItemColor: c.accentDim
        DialogInputFieldColor: c.dropdownBg
        DialogKeyboardColor: c.dropdownBg
        DialogFootprintColor: c.accentFaint
    }
    return palette
end function