' Bounded session cache. Only serialized validated catalog/meta results live here.
' The owning ResponseCache node serializes access from all Task threads.
class ResponseCacheStore
    entries as object
    clock as object
    generation as integer
    bytes as integer
    sequence as integer
    maxBytes as integer
    maxEntries as integer
    maxEntryBytes as integer
    hits as integer
    misses as integer
    evictions as integer
    expired as integer
    rejected as integer

    sub new(clock = invalid as dynamic, maxBytes = 2097152 as integer, maxEntries = 64 as integer, maxEntryBytes = 524288 as integer)
        if clock = invalid then clock = CreateObject("roTimespan")
        m.clock = clock
        m.entries = []
        m.generation = 0
        m.bytes = 0
        m.sequence = 0
        m.maxBytes = maxBytes
        m.maxEntries = maxEntries
        m.maxEntryBytes = maxEntryBytes
        m.hits = 0
        m.misses = 0
        m.evictions = 0
        m.expired = 0
        m.rejected = 0
    end sub

    function GetGeneration() as integer
        return m.generation
    end function

    function Read(key as string, generation as integer) as string
        m.Prune()
        if generation = m.generation
            for each entry in m.entries
                ' Array/string comparison preserves case-sensitive URL identity.
                if entry.key = key
                    m.sequence = m.sequence + 1
                    entry.used = m.sequence
                    m.hits = m.hits + 1
                    return entry.cacheText
                end if
            end for
        end if
        m.misses = m.misses + 1
        return ""
    end function

    function Write(key as string, cacheText as string, ttl as integer, generation as integer) as boolean
        m.Prune()
        if generation <> m.generation or ttl <= 0 or key = "" or cacheText = "" then return false
        ' Four bytes per string unit is conservative for UTF-8/UTF-16; this is
        ' a serialized-data budget, not a promise about total process DRAM.
        if key.Len() > 8192 or cacheText.Len() > m.maxEntryBytes then return false
        cost = 4 * (key.Len() + cacheText.Len()) + 128
        if cost > m.maxEntryBytes or cost > m.maxBytes or m.maxEntries <= 0
            m.rejected = m.rejected + 1
            return false
        end if
        for i = m.entries.Count() - 1 to 0 step -1
            if m.entries[i].key = key then m.RemoveAt(i)
        end for
        while m.entries.Count() >= m.maxEntries or m.bytes + cost > m.maxBytes
            oldest = 0
            for i = 1 to m.entries.Count() - 1
                if m.entries[i].used < m.entries[oldest].used then oldest = i
            end for
            m.RemoveAt(oldest)
            m.evictions = m.evictions + 1
        end while
        m.sequence = m.sequence + 1
        m.entries.Push({ key: key, cacheText: cacheText, cost: cost, used: m.sequence, expiresAt: m.clock.TotalSeconds() + ttl })
        m.bytes = m.bytes + cost
        return true
    end function

    sub RemoveAt(index as integer)
        m.bytes = m.bytes - m.entries[index].cost
        m.entries.Delete(index)
    end sub

    sub Prune()
        now = m.clock.TotalSeconds()
        for i = m.entries.Count() - 1 to 0 step -1
            if m.entries[i].expiresAt <= now
                m.RemoveAt(i)
                m.expired = m.expired + 1
            end if
        end for
    end sub

    sub Clear()
        m.entries = []
        m.bytes = 0
        m.generation = m.generation + 1
    end sub

    function Stats() as object
        m.Prune()
        return { entries: m.entries.Count(), reservedBytes: m.bytes, maxBytes: m.maxBytes, maxEntries: m.maxEntries, hits: m.hits, misses: m.misses, evictions: m.evictions, expired: m.expired, rejected: m.rejected, generation: m.generation }
    end function
end class
